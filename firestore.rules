rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Packages, promotions, banners, equipment, articles, faqs, settings, about are public for read and admin-managed for write
    match /packages/{document=**} {
      allow read, write: if true;
    }
    match /promotions/{document=**} {
      allow read, write: if true;
    }
    match /banners/{document=**} {
      allow read, write: if true;
    }
    match /equipment/{document=**} {
      allow read, write: if true;
    }
    match /articles/{document=**} {
      allow read, write: if true;
    }
    match /faqs/{document=**} {
      allow read, write: if true;
    }
    match /settings/{document=**} {
      allow read, write: if true;
    }
    match /about/{document=**} {
      allow read, write: if true;
    }
    match /leads/{document=**} {
      allow read, write: if true;
    }
    match /applications/{document=**} {
      allow read, write: if true;
    }
    match /notifications/{document=**} {
      allow read, write: if true;
    }
    match /contact_messages/{document=**} {
      allow read, write: if true;
    }
    match /admin_users/{document=**} {
      allow read, write: if true;
    }
  }
}
