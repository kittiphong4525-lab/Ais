        "badge": { "type": "string" },
        "image": { "type": "string" },
        "active": { "type": "boolean" },
        "start_date": { "type": "string" },
        "end_date": { "type": "string" },
        "recommendedFor": { "type": "string" },
        "tvIncluded": { "type": "boolean" }
